# Database (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name?schema=public
# For empty password, use: postgresql://username:@localhost:5432/database_name?schema=public
DATABASE_URL="postgresql://anthon:@localhost:5432/intelligentforms?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

